{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelport.dev/schemas/runtime-adapter-capabilities-v1alpha1.schema.json",
  "title": "ModelPort Runtime Adapter capabilities v1alpha1", "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "runtime.modelport.io/v1alpha1" }, "kind": { "const": "RuntimeAdapterCapabilities" },
    "metadata": { "$ref": "#/$defs/metadata" }, "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,61}[a-z0-9])?$" },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["adapterId", "displayName", "adapterVersion"],
      "properties": {
        "adapterId": { "$ref": "#/$defs/identifier" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adapterVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "authentication": {
      "type": "object", "additionalProperties": false, "required": ["schemes", "transport"],
      "properties": {
        "schemes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["bearer", "mutual_tls"] } },
        "transport": { "enum": ["tls_required", "tls_or_loopback"] }
      }
    },
    "inferenceProtocol": {
      "type": "object", "additionalProperties": false, "required": ["id", "versions"],
      "properties": {
        "id": { "enum": ["openai_compatible", "anthropic"] },
        "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["operationId", "method", "path", "sideEffectFree"],
      "properties": {
        "operationId": { "enum": ["capabilities.get", "health.get", "inventory.models.list", "inventory.compute.list", "inventory.deployments.list"] },
        "method": { "const": "GET" }, "path": { "type": "string", "pattern": "^/runtime-adapter/v1alpha1/[a-z0-9_./-]+$", "maxLength": 160 }, "sideEffectFree": { "const": true }
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["authentication", "runtimeEngines", "inferenceProtocols", "inventoryKinds", "operations"],
      "properties": {
        "authentication": { "$ref": "#/$defs/authentication" }, "runtimeEngines": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "inferenceProtocols": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/inferenceProtocol" } },
        "inventoryKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["model", "compute_node", "gpu", "deployment"] } },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }, "extensions": { "type": "object", "additionalProperties": true }
      }
    }
  }
}
