{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modelport.dev/schemas/runtime-adapter-compute-inventory-v1alpha1.schema.json",
  "title": "ModelPort Runtime Adapter compute inventory v1alpha1", "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "nodes"],
  "properties": {
    "apiVersion": { "const": "runtime.modelport.io/v1alpha1" }, "kind": { "const": "RuntimeAdapterComputeInventory" },
    "metadata": { "$ref": "#/$defs/metadata" }, "nodes": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/node" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "extensionScalar": { "anyOf": [
      { "type": "boolean" }, { "type": "integer", "minimum": -9223372036854775808, "maximum": 9223372036854775807 },
      { "type": "number", "minimum": -1e308, "maximum": 1e308 }, { "type": "string", "maxLength": 512 }
    ] },
    "extensions": {
      "type": "object", "maxProperties": 32,
      "propertyNames": { "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
      "additionalProperties": { "oneOf": [
        { "$ref": "#/$defs/extensionScalar" }, { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/extensionScalar" } }
      ] }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["collectorId", "collectorVersion"],
      "properties": {
        "collectorId": { "$ref": "#/$defs/identifier" }, "collectorVersion": { "$ref": "#/$defs/version" }, "sourceRevision": { "$ref": "#/$defs/version" }
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["adapterId", "snapshotId", "observedAt", "source"],
      "properties": {
        "adapterId": { "$ref": "#/$defs/identifier" }, "snapshotId": { "$ref": "#/$defs/identifier" },
        "observedAt": { "type": "string", "format": "date-time" }, "source": { "$ref": "#/$defs/source" }, "extensions": { "$ref": "#/$defs/extensions" }
      }
    },
    "memory": {
      "type": "object", "additionalProperties": false, "required": ["totalBytes", "availableBytes"],
      "properties": {
        "totalBytes": { "type": "integer", "minimum": 1, "maximum": 9223372036854775807 }, "availableBytes": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      }
    },
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["gpuId", "idSource", "deviceClass", "vendor", "model", "health", "memory"],
      "properties": {
        "gpuId": { "$ref": "#/$defs/identifier" }, "idSource": { "enum": ["vendor_uuid", "vendor_serial", "operator_assigned"] },
        "deviceClass": { "enum": ["physical", "partition"] }, "parentGpuId": { "$ref": "#/$defs/identifier" },
        "vendor": { "enum": ["nvidia", "amd", "intel", "other"] }, "model": { "type": "string", "minLength": 1, "maxLength": 160 },
        "health": { "enum": ["available", "degraded", "unavailable", "unknown"] }, "memory": { "$ref": "#/$defs/memory" },
        "driverVersion": { "$ref": "#/$defs/version" }, "pciAddress": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}:[0-9A-Fa-f]{2}:[0-9A-Fa-f]{2}\\.[0-7]$" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [{ "if": { "properties": { "deviceClass": { "const": "partition" } }, "required": ["deviceClass"] },
        "then": { "required": ["parentGpuId"] }, "else": { "not": { "required": ["parentGpuId"] } } }]
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeId", "idSource", "architecture", "operatingSystem", "health", "gpus"],
      "properties": {
        "nodeId": { "$ref": "#/$defs/identifier" }, "idSource": { "enum": ["machine_id", "cloud_instance_id", "operator_assigned"] },
        "hostName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "architecture": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9_-]*$" },
        "operatingSystem": { "type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "health": { "enum": ["available", "degraded", "unavailable", "unknown"] },
        "gpus": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/gpu" } }, "extensions": { "$ref": "#/$defs/extensions" }
      }
    }
  }
}
